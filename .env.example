# Examples only; never commit real secrets.
RELAY_BIND_HOST=127.0.0.1
RELAY_PORT=8787
RELAY_DB_PATH=./data/relay.sqlite
# Resolve credentials from approved secret storage at runtime.
DISCORD_BOT_TOKEN=
RELAY_CLIENT_TOKEN=
RELAY_PRINCIPAL_ID=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_RELAY_BOT_ID=
DISCORD_CHRIS_BOT_ID=
RELAY_TARGET_ALIAS=chris-primary
RELAY_REPLY_TIMEOUT_SECONDS=120
RELAY_ALLOWED_ORIGIN=
RELAY_TEXT_RETENTION_DAYS=7
RELAY_METADATA_RETENTION_DAYS=30
RELAY_MODE=mock
# Added in implementation (optional):
RELAY_RATE_LIMIT_PER_MINUTE=10
# mock mode only: request_id | reference | none | silent
RELAY_MOCK_CHRIS=request_id
# Set to 1 to revoke the principal without rotating the token
RELAY_PRINCIPAL_DISABLED=
# Tailscale Serve exposure (docs/access-tailscale-serve.md): require this tailnet login in addition to the bearer token
RELAY_TAILSCALE_LOGINS=
# P1 voice client (Siri Shortcut / Even AI): separate token, POST /v1/ask only. Empty = /v1/ask disabled.
RELAY_VOICE_TOKEN=
# default: <RELAY_PRINCIPAL_ID>.voice
RELAY_VOICE_PRINCIPAL_ID=
# Set to 1 to revoke the voice client without rotating its token
RELAY_VOICE_DISABLED=
# How relayed posts refer to the owner ("Discord에서 <title> 확인"), default 사용자
RELAY_OWNER_TITLE=
