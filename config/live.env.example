# Copy to config/live.env (untracked) and fill in. IDs are not secrets but identify your server; keep them local.
# Discord developer mode → right-click → Copy ID.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_RELAY_BOT_ID=
DISCORD_CHRIS_BOT_ID=
# Optional: principal id stored with requests/devices (default owner) and how posts refer to you (default 사용자)
RELAY_PRINCIPAL_ID=
RELAY_OWNER_TITLE=
